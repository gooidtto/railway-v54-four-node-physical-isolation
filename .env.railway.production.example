# Railway Production V5
NODE_MODE=4

# Railway supplies these automatically; do not hard-code them.
# RAILWAY_PUBLIC_DOMAIN
# RAILWAY_TCP_PROXY_DOMAIN
# RAILWAY_TCP_PROXY_PORT

# Node 4: all six are mandatory in NODE_MODE=4.
CLOUDFLARE_TUNNEL_TOKEN=
CLOUDFLARE_TUNNEL_ID=
CLOUDFLARE_PUBLIC_HOSTNAME=ws.example.com
CLOUDFLARE_ORIGIN_SERVICE=http://127.0.0.1:18080
WS_PORT=18080
WS_PATH=/ws

REALITY_FINGERPRINT=chrome
REALITY_RAW_SNI=www.cloudflare.com
REALITY_RAW_TARGET=www.cloudflare.com:443
REALITY_XHTTP_SNI=www.apple.com
REALITY_XHTTP_TARGET=www.apple.com:443
XHTTP_PATH=/xhttp
