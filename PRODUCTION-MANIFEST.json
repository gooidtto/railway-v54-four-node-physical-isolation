{
  "schema": 2,
  "kind": "runtime-capability-policy",
  "description": "Static policy only. Runtime node names, endpoints, count and capabilities are discovered from the current Railway deployment environment and generated at startup.",
  "runtime_discovery": {
    "public_domain": "RAILWAY_PUBLIC_DOMAIN",
    "tcp_proxy_domain": "RAILWAY_TCP_PROXY_DOMAIN",
    "tcp_proxy_port": "RAILWAY_TCP_PROXY_PORT",
    "cloudflare": [
      "CLOUDFLARE_TUNNEL_TOKEN",
      "CLOUDFLARE_TUNNEL_ID",
      "CLOUDFLARE_PUBLIC_HOSTNAME",
      "CLOUDFLARE_ORIGIN_SERVICE",
      "WS_PORT",
      "WS_PATH"
    ]
  },
  "node_policy": {
    "base": "generate from available Railway networking",
    "cloudflare": "generate when complete Cloudflare configuration is present",
    "count": "runtime-derived",
    "names": "runtime-derived",
    "endpoints": "runtime-derived"
  },
  "core_capabilities": {
    "single_gateway": true,
    "sni_routing": true,
    "fragmented_clienthello": true,
    "dynamic_railway_networking": true,
    "subscription_generation": true,
    "uuid_invariant": true,
    "cloudflare_tunnel": true
  },
  "invariants": [
    "uuid-match",
    "subscription-count-match",
    "current-networking-authoritative",
    "fragmented-clienthello-routing",
    "cloudflare-ready-when-configured"
  ]
}
