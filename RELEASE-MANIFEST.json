{
  "release": "stable-optional-cloudflare-ws-v4",
  "architecture": "single-8080-router-plus-optional-cloudflare-tunnel",
  "base_nodes": 3,
  "max_nodes": 4,
  "application_port": 8080,
  "entries": {
    "443": "xhttp-tls",
    "tcp-proxy": "raw-reality-vision + xhttp-reality",
    "cloudflare": "optional-ws-tls"
  },
  "routing": {
    "http": 10086,
    "raw_reality_sni": 10087,
    "xhttp_reality_sni": 10088,
    "cloudflare_ws": "optional"
  },
  "source_of_truth": "main",
  "cloudflare_enablement": "CLOUDFLARE_TUNNEL_TOKEN + CLOUDFLARE_TUNNEL_ID + CLOUDFLARE_PUBLIC_HOSTNAME + CLOUDFLARE_ORIGIN_SERVICE + WS_PORT + WS_PATH"
}
