{
  "release": "fixed-single-8080-router-v1",
  "architecture": "single-8080-protocol-router",
  "nodes": 4,
  "application_port": 8080,
  "entries": {
    "443": "xhttp-tls",
    "tcp-proxy-1": "raw-reality-vision",
    "tcp-proxy-2": "grpc-reality",
    "tcp-proxy-3": "ws-tls"
  },
  "routing": {
    "http": 10086,
    "raw_reality_sni": 10087,
    "grpc_reality_sni": 10088,
    "ws_sni": 10089
  },
  "source_of_truth": "main"
}
