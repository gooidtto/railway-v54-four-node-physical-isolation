# Railway supplies the current deployment endpoints automatically.
# Never copy old Railway domains or ports between projects.
# RAILWAY_PUBLIC_DOMAIN
# RAILWAY_TCP_PROXY_DOMAIN
# RAILWAY_TCP_PROXY_PORT

# Optional display names only. They never affect routing.
NODE_01_NAME=Node 01
NODE_02_NAME=Node 02
NODE_03_NAME=Node 03
NODE_04_NAME=Node 04

# Node 4 capability: leave ALL six empty for the 3-node base topology,
# or provide ALL six for automatic Cloudflare Node 4 discovery.
CLOUDFLARE_TUNNEL_TOKEN=
CLOUDFLARE_TUNNEL_ID=
CLOUDFLARE_PUBLIC_HOSTNAME=
CLOUDFLARE_ORIGIN_SERVICE=
WS_PORT=
WS_PATH=

REALITY_FINGERPRINT=chrome
REALITY_RAW_SNI=www.cloudflare.com
REALITY_RAW_TARGET=www.cloudflare.com:443
REALITY_XHTTP_SNI=www.apple.com
REALITY_XHTTP_TARGET=www.apple.com:443
XHTTP_PATH=/xhttp

# Policy is derived from the actual deployment.
NODE_MODE=auto
EXPECTED_NODES=auto
